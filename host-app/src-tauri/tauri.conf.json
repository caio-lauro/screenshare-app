{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ScreenShare",
  "version": "0.3.1",
  "identifier": "com.joojinhudololzinho.screenshare",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Compartilhamento de Tela",
        "width": 900,
        "height": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/server"]
  }
}
